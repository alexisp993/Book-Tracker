# --- Database (Postgres) ---
# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection string (used by `prisma db push`). On Neon/Vercel this is
# provided as DATABASE_URL_UNPOOLED. If you only have one URL, set both to the same value.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# --- Auth (single-password gate) ---
# The password you'll type on the login screen.
APP_PASSWORD="choose-a-strong-password"
# Long random string used to sign the session cookie (e.g. `openssl rand -base64 32`).
AUTH_SECRET="generate-a-long-random-secret"

