# --- Database (Postgres) ---
# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Direct (non-pooled) connection string (used by `prisma db push`). On Neon/Vercel this is
# provided as DATABASE_URL_UNPOOLED. If you only have one URL, set both to the same value.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# --- Book metadata (Google Books) ---
# Strongly recommended in production: a free Google Books API key. Without it, Google Books
# is rate-limited per shared server IP (429 on Vercel) and many books won't be found.
# Get one (free, no billing) at https://console.cloud.google.com → enable "Books API" → create API key.
GOOGLE_BOOKS_API_KEY=""
# Country code for Google Books results (required by the API). Set to your country, e.g. GB or US.
GOOGLE_BOOKS_COUNTRY="US"

# --- Auth (real per-user accounts) ---
# Long random string used to sign every session cookie (e.g. `openssl rand -base64 32`).
AUTH_SECRET="generate-a-long-random-secret"
# OLD shared password — only used by the one-time /migrate page that bridges the original
# single-account setup to real per-user login. Not used for day-to-day access anymore.
APP_PASSWORD="choose-a-strong-password"
# Comma-separated admin emails. Whoever registers/logs in/migrates with a matching email
# becomes an admin (re-checked on every login).
ADMIN_EMAILS="you@example.com"
# Closed-beta registration cap. Optional — defaults to 30.
MAX_BETA_USERS=30

# --- Feedback screenshots (optional) ---
# Auto-provisioned when you create a Vercel Blob store (Storage tab in the Vercel dashboard).
# Without it, feedback screenshot upload returns a friendly "not configured yet" message;
# submitting feedback without a screenshot still works.
# BLOB_READ_WRITE_TOKEN=""

# --- AI (stubbed this phase; not required to run) ---
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Image storage (future phase) ---
# CLOUDINARY_URL=""
