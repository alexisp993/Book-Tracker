# --- Database ---
# SQLite for local development (zero setup). For production (Vercel), set this to a
# Postgres connection string and change the provider in prisma/schema.prisma. See docs/DEPLOY.md.
DATABASE_URL="file:./dev.db"

# --- Auth (single-password gate) ---
# The password you'll type on the login screen.
APP_PASSWORD="choose-a-strong-password"
# Long random string used to sign the session cookie (e.g. `openssl rand -base64 32`).
AUTH_SECRET="generate-a-long-random-secret"

# --- AI (stubbed this phase; not required to run) ---
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Auth (future phase; not used yet) ---
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Image storage (future phase) ---
# CLOUDINARY_URL=""
